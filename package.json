{
  "name": "walkout",
  "version": "0.1.0",
  "description": "Persona shoppers walk through a real shop, telemetry shows where they gave up, the fix is proven by a re-run.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:probe": "node scripts/build-probe.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build:probe",
    "test": "node --import tsx --test test/*.test.ts",
    "test:shop": "tsx scripts/shop-smoke.ts",
    "shop": "tsx src/cli.ts shop",
    "run": "tsx src/cli.ts run",
    "scoreboard": "tsx src/cli.ts scoreboard",
    "demo": "npm run build:probe && tsx src/cli.ts demo"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/instrumentation-document-load": "0.68.0",
    "@opentelemetry/instrumentation-fetch": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-web": "2.12.0",
    "playwright": "1.64.1",
    "web-vitals": "6.2.3"
  }
}
